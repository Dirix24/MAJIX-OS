#!/bin/sh
set -eu

. ../config/binary
persistence_options="persistence persistence-media=removable-usb persistence-storage=filesystem persistence-encryption=none persistence-label=MAJIX_DATA"
temporary_options="${LB_BOOTAPPEND_LIVE%" $persistence_options"}"
test "$temporary_options" != "$LB_BOOTAPPEND_LIVE"

test -s isolinux/live.cfg
test -s boot/grub/grub.cfg
test -s live/vmlinuz
test -s live/initrd.img

cat >> isolinux/live.cfg <<SYSLINUX

label majix-temporary
    menu label MAJIX OS - Sesion temporal (sin guardar)
    linux /live/vmlinuz
    initrd /live/initrd.img
    append ${temporary_options} nopersistence
SYSLINUX

cat >> boot/grub/grub.cfg <<GRUB

menuentry "MAJIX OS - Sesion temporal (sin guardar)" {
    linux /live/vmlinuz ${temporary_options} nopersistence findiso=\${iso_path}
    initrd /live/initrd.img
}
GRUB

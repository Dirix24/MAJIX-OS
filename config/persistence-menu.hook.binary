#!/bin/sh
set -eu

. ../config/binary
persistence_options="persistence persistence-media=removable-usb persistence-storage=filesystem persistence-encryption=none persistence-label=MAJIX_DATA"
temporary_options="${LB_BOOTAPPEND_LIVE%" $persistence_options"}"
test "$temporary_options" != "$LB_BOOTAPPEND_LIVE"

test -s isolinux/live.cfg
test -s boot/grub/grub.cfg
test -s live/vmlinuz
test -s live/initrd.img

cat >> isolinux/live.cfg <<SYSLINUX

label majix-temporary
    menu label MAJIX OS - Sesion temporal (sin guardar)
    linux /live/vmlinuz
    initrd /live/initrd.img
    append ${temporary_options} nopersistence
label majix-safe-graphics
    menu label MAJIX OS - Graficos seguros
    linux /live/vmlinuz
    initrd /live/initrd.img
    append ${LB_BOOTAPPEND_LIVE} nomodeset plymouth.enable=0
SYSLINUX

cat >> boot/grub/grub.cfg <<GRUB

menuentry "MAJIX OS - Sesion temporal (sin guardar)" {
    linux /live/vmlinuz ${temporary_options} nopersistence findiso=\${iso_path}
    initrd /live/initrd.img
}
menuentry "MAJIX OS - Graficos seguros" {
    linux /live/vmlinuz ${LB_BOOTAPPEND_LIVE} nomodeset plymouth.enable=0 findiso=\${iso_path}
    initrd /live/initrd.img
}
GRUB

# Both BIOS and UEFI use the MAJIX menu names and keep the troubleshooting entries.
sed -i 's/\^Live system (amd64)/^Iniciar MAJIX OS/; s/Live system (amd64 fail-safe mode)/MAJIX OS - Diagnostico avanzado/' isolinux/live.cfg
sed -i 's/^menu title .*/menu title MAJIX OS/' isolinux/menu.cfg
sed -i '/^menu background /d' isolinux/stdmenu.cfg
sed -i 's/Live system (amd64)/Iniciar MAJIX OS/; s/Live system (amd64 fail-safe mode)/MAJIX OS - Diagnostico avanzado/; s/Utilities\.\.\./Utilidades/' boot/grub/grub.cfg
cat > boot/grub/theme.cfg <<'GRUB_THEME'
set theme=/boot/grub/majix-theme.txt
export theme
GRUB_THEME
cat > boot/grub/majix-theme.txt <<'THEME'
title-text: "MAJIX OS"
title-color: "#6EF6EE"
desktop-color: "#0B151F"
+ image {
    file = "majix-emblem.png"
    left = 40%
    top = 12%
}
+ boot_menu {
    left = 16%
    top = 54%
    width = 70%
    height = 37%
    item_color = "#B1CFDA"
    selected_item_color = "#6EF6EE"
    item_height = 23
    item_spacing = 5
    item_padding = 4
}
THEME

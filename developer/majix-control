#!/usr/bin/python3
"""Read-only system information for the MAJIX desktop."""
import shutil
import subprocess
from pathlib import Path

from PyQt6.QtCore import QProcess, Qt, QTimer
from PyQt6.QtWidgets import (
    QApplication, QComboBox, QFormLayout, QLabel, QMessageBox, QPushButton, QVBoxLayout, QWidget,
)


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def command(*args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=1)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip()


def snapshot():
    memory = dict(line.split(":", 1) for line in read("/proc/meminfo").splitlines())
    total = int(memory.get("MemTotal", "0 kB").split()[0]) / 1024**2
    available = int(memory.get("MemAvailable", "0 kB").split()[0]) / 1024**2
    cpu = next((line.split(":", 1)[1].strip() for line in read("/proc/cpuinfo").splitlines()
                if line.startswith("model name") and ":" in line), "Sin datos")
    temperatures = []
    for zone in sorted(Path("/sys/class/thermal").glob("thermal_zone*")):
        value = read(zone / "temp")
        if value.lstrip("-").isdigit():
            temperatures.append(f"{read(zone / 'type') or zone.name} {int(value) / 1000:.0f} °C")
    version = next((line.partition("=")[2].strip('"')
                    for line in read("/usr/lib/majix-release").splitlines()
                    if line.startswith("PRETTY_NAME=")), "Sin datos")
    return {
        "Versión": version,
        "Procesador": cpu,
        "RAM disponible": f"{available:.1f} de {total:.1f} GiB",
        "Espacio disponible para el sistema": f"{shutil.disk_usage('/').free / 1024**3:.1f} GiB",
        "Persistencia": command("majix-storage") or "Estado sin confirmar",
        "Temperaturas": ", ".join(temperatures) or "Sin sensores disponibles",
    }


class ControlCenter(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("MAJIX Control Center")
        self.resize(660, 370)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 24)
        title = QLabel("MAJIX Control Center")
        title.setObjectName("title")
        layout.addWidget(title)
        form = QFormLayout()
        layout.addLayout(form)
        self.labels = {}
        for name, value in snapshot().items():
            label = QLabel(value)
            label.setWordWrap(True)
            self.labels[name] = label
            form.addRow(name, label)
        refresh = QPushButton("Actualizar estado")
        refresh.clicked.connect(self.refresh)
        layout.addWidget(refresh)
        self.profile = QComboBox()
        self.tools = QComboBox()
        for line in command("majix-tools", "list").splitlines():
            identifier, name = line.split("|", 1)
            self.profile.addItem(name, identifier)
            if identifier not in {"universal", "full"}:
                self.tools.addItem(name, identifier)
        self.active = QLabel()
        form.addRow("Modo activo", self.active)
        form.addRow("Elegir modo", self.profile)
        self.description = QLabel()
        self.description.setWordWrap(True)
        form.addRow(self.description)
        self.tools_label = QLabel("Herramientas de Tec Universal")
        form.addRow(self.tools_label, self.tools)
        save = QPushButton("Guardar modo")
        save.clicked.connect(self.save_profile)
        layout.addWidget(save)
        self.install = QPushButton("Revisar e instalar en Konsole")
        self.install.clicked.connect(self.install_profile)
        layout.addWidget(self.install)
        self.profile.currentIndexChanged.connect(self.describe_profile)
        self.profile.setCurrentIndex(max(0, self.profile.findData(command("majix-tools", "active"))))
        self.describe_profile()
        self.show_active()

        self.update = QPushButton("Buscar una compilación de MAJIX")
        self.update.clicked.connect(self.check_update)
        self.check = QProcess(self)
        self.check.finished.connect(self.show_update)
        self.check.errorOccurred.connect(lambda _: self.update.setEnabled(True))
        layout.addWidget(self.update)
        layout.addStretch()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(30000)

    def describe_profile(self):
        identifier = self.profile.currentData()
        if identifier:
            self.description.setText(command("majix-tools", "describe", identifier))
        self.tools.setVisible(identifier == "universal")
        self.tools_label.setVisible(identifier == "universal")

    def show_active(self):
        index = self.profile.findData(command("majix-tools", "active"))
        self.active.setText(self.profile.itemText(index) if index >= 0 else "Sin confirmar")

    def save_profile(self):
        identifier = self.profile.currentData()
        if not identifier:
            return
        if identifier == "full":
            self.install_profile()
            return
        result = subprocess.run(["majix-tools", "select", identifier], text=True, capture_output=True)
        if result.returncode:
            QMessageBox.warning(self, "Modo tecnológico", result.stdout.strip() or result.stderr.strip())
        self.show_active()

    def install_profile(self):
        identifier = self.profile.currentData()
        if identifier == "universal":
            if command("majix-tools", "active") != "universal":
                self.save_profile()
                if command("majix-tools", "active") != "universal":
                    return
            identifier = self.tools.currentData()
        if not identifier:
            return
        try:
            subprocess.Popen(["konsole", "--hold", "-e", "majix-tools", "install", identifier])
        except OSError as error:
            QMessageBox.warning(self, "MAJIX Control Center", f"No se pudo abrir Konsole. {error}")

    def check_update(self):
        self.update.setEnabled(False)
        self.check.start("majix-build-check", [])

    def show_update(self):
        self.update.setEnabled(True)
        dialog = QMessageBox(self)
        dialog.setWindowTitle("Actualizaciones de MAJIX")
        dialog.setTextFormat(Qt.TextFormat.PlainText)
        dialog.setText(bytes(self.check.readAllStandardOutput()).decode().strip()
                       or "No se pudo consultar GitHub.")
        dialog.exec()

    def refresh(self):
        for name, value in snapshot().items():
            self.labels[name].setText(value)
        self.show_active()


def main():
    app = QApplication([])
    app.setStyle("Fusion")
    app.setStyleSheet("""
        QWidget { background: #0b151f; color: #def1f5; font-size: 14px; }
        QLabel#title { color: #62efec; font-size: 28px; font-weight: 700; }
        QPushButton { background: #162735; border: 1px solid #8879c7; padding: 8px; }
        QPushButton:hover, QPushButton:focus { border-color: #62efec; }
    """)
    window = ControlCenter()
    window.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/python3
"""MAJIX Studio desktop project and file manager."""
import json
import os
from pathlib import Path
import shutil
import subprocess

from PyQt6.QtCore import QUrl
from PyQt6.QtGui import QDesktopServices, QIcon
from PyQt6.QtWidgets import (
    QApplication, QComboBox, QFileDialog, QFormLayout, QHBoxLayout, QLabel,
    QLineEdit, QMessageBox, QPushButton, QVBoxLayout, QWidget,
)

ASSETS = Path("/usr/share/majix")
FILESYSTEMS = {"vfat", "exfat", "ext4", "ntfs", "ntfs3", "btrfs"}
TEMPLATES = {
    "Python": ("main.py", 'print("Hola, MAJIX OS")\n'),
    "JavaScript": ("main.js", 'console.log("Hola, MAJIX OS");\n'),
    "C": ("main.c", '#include <stdio.h>\n\nint main(void) {\n    puts("Hola, MAJIX OS");\n    return 0;\n}\n'),
}


def output(args):
    return subprocess.check_output(args, text=True).strip()


def devices():
    """List writable storage media while identifying the actual boot USB."""
    boot = subprocess.run(
        ["findmnt", "-n", "-o", "SOURCE", "--mountpoint", "/run/live/medium"],
        text=True, capture_output=True, check=False,
    ).stdout.strip()
    disks = json.loads(output(
        ["lsblk", "-J", "-p", "-o", "NAME,TYPE,TRAN,RM,RO,LABEL,FSTYPE,MOUNTPOINTS"]
    ))["blockdevices"]
    for disk in disks:
        if disk["ro"] or not (disk["tran"] == "usb" or disk["rm"]):
            continue
        partitions = disk.get("children", [disk])
        boot_disk = any(partition["name"] == boot for partition in partitions)
        for partition in partitions:
            if partition["ro"] or partition["fstype"] not in FILESYSTEMS:
                continue
            if partition["name"] == boot or (boot_disk and partition["label"] != "MAJIXWORK"):
                continue
            yield boot_disk, partition


def mount_destination(device):
    mountpoints = [p for p in device["mountpoints"] if p and p.startswith(("/media/", "/run/media/"))]
    if not mountpoints:
        subprocess.run(["udisksctl", "mount", "--block-device", device["name"]],
                       capture_output=True, text=True, check=True)
        found = next((entry for _, entry in devices() if entry["name"] == device["name"]), None)
        if found:
            mountpoints = [p for p in found["mountpoints"] if p and p.startswith(("/media/", "/run/media/"))]
    if len(mountpoints) != 1:
        raise OSError("No se pudo determinar la carpeta montada de esa unidad.")
    destination = Path(mountpoints[0])
    if not os.access(destination, os.W_OK):
        raise OSError("La unidad está montada sin permiso de escritura.")
    return destination


def write_folder(destination, name, populate):
    if not name.strip() or name in (".", "..") or any(c in name for c in '/\\:*?"<>|'):
        raise ValueError("Escribe un nombre de carpeta válido.")
    folder = destination / name
    folder.mkdir()
    try:
        populate(folder)
    except Exception:
        shutil.rmtree(folder)
        raise
    return folder


def create_project(destination, name, language):
    filename, source = TEMPLATES[language]

    def populate(folder):
        (folder / filename).write_text(source, encoding="utf-8")
        (folder / "README.md").write_text(f"# {name}\n\nProyecto {language} creado en MAJIX Studio.\n", encoding="utf-8")

    return write_folder(destination, name, populate)


def copy_batch(destination, name, sources):
    if len({path.name.casefold() for path in sources}) != len(sources):
        raise ValueError("Hay nombres repetidos. Cambia uno antes de copiar.")
    if sum(path.stat().st_size for path in sources) > shutil.disk_usage(destination).free:
        raise OSError("La unidad no tiene espacio suficiente para todos los archivos.")

    def populate(folder):
        for path in sources:
            with path.open("rb") as source, (folder / path.name).open("xb") as target:
                shutil.copyfileobj(source, target, 1024 * 1024)

    return write_folder(destination, name, populate)


class Studio(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("MAJIX Studio")
        self.setWindowIcon(QIcon(str(ASSETS / "emblem.png")))
        self.resize(730, 450)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 26, 28, 26)
        layout.setSpacing(16)
        title = QLabel("MAJIX Studio")
        title.setObjectName("title")
        layout.addWidget(title)
        layout.addWidget(QLabel("Crea proyectos y guarda tu trabajo en la unidad que elijas."))
        fields = QFormLayout()
        self.name = QLineEdit()
        self.name.setPlaceholderText("Ejemplo: mi-proyecto")
        self.language = QComboBox()
        self.language.addItems(TEMPLATES)
        self.destination = QComboBox()
        fields.addRow("Nombre de carpeta", self.name)
        fields.addRow("Plantilla", self.language)
        fields.addRow("Destino", self.destination)
        layout.addLayout(fields)
        actions = QHBoxLayout()
        for label, action in (
            ("Crear proyecto", self.project), ("Copiar varios archivos", self.transfer),
            ("Actualizar unidades", self.refresh),
        ):
            button = QPushButton(label)
            button.clicked.connect(action)
            actions.addWidget(button)
        layout.addLayout(actions)
        tools = QHBoxLayout()
        for text, command in (("Terminal", "konsole"), ("Editor", "kate"), ("Archivos", "dolphin")):
            button = QPushButton(text)
            button.clicked.connect(lambda checked=False, cmd=command: subprocess.Popen([cmd]))
            tools.addWidget(button)
        layout.addLayout(tools)
        self.status = QLabel()
        self.status.setWordWrap(True)
        layout.addWidget(self.status)
        layout.addStretch()
        self.refresh()

    def refresh(self):
        self.destination.clear()
        try:
            available = sorted(devices(), key=lambda item: not item[0])
        except (OSError, subprocess.CalledProcessError, ValueError):
            available = []
        for is_boot, device in available:
            label = device["label"] or device["name"]
            title = "USB de MAJIX" if is_boot else "Dispositivo conectado"
            self.destination.addItem(f"{title} · {label}", device)
        if not available:
            self.destination.addItem("Sin destino extraíble")
        self.status.setText("Conecta una unidad y actualiza la lista si no ves el destino.")

    def run_action(self, action):
        try:
            device = self.destination.currentData()
            if not device:
                raise ValueError("Elige una unidad de destino.")
            # Recheck after a hot unplug before trying to mount or write.
            current = next((item for _, item in devices() if item == device), None)
            if current is None:
                raise OSError("La unidad cambió. Actualiza la lista y vuelve a elegirla.")
            target = action(mount_destination(current), self.name.text().strip())
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            QMessageBox.warning(self, "MAJIX Studio", str(error))
            return
        self.status.setText(f"Guardado en {target}")
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(target)))

    def project(self):
        self.run_action(lambda destination, name: create_project(destination, name, self.language.currentText()))

    def transfer(self):
        paths, _ = QFileDialog.getOpenFileNames(self, "Elige los archivos para copiar")
        if paths:
            self.run_action(lambda destination, name: copy_batch(destination, name, [Path(p) for p in paths]))


def main():
    app = QApplication([])
    app.setStyle("Fusion")
    app.setStyleSheet("""
        QWidget { background: #0b151f; color: #def1f5; font-size: 14px; }
        QLabel#title { color: #62efec; font-size: 34px; font-weight: 700; }
        QLineEdit, QComboBox, QPushButton {
            background: #162735; border: 1px solid #355466; border-radius: 7px; padding: 8px;
        }
        QPushButton:hover { border-color: #62efec; }
        QLineEdit:focus, QComboBox:focus, QPushButton:focus { border-color: #62efec; }
    """)
    studio = Studio()
    studio.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())

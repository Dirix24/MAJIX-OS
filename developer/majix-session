#!/bin/sh
set -eu
if ! storage=$(majix-storage --require-full); then
    kdialog --title 'Almacenamiento de MAJIX OS' --sorry "$storage

Guarda el trabajo importante en una unidad escribible. Para diagnosticar el arranque, abre Konsole y ejecuta majix-storage y lsblk -f." || true
fi

state=${XDG_CONFIG_HOME:-"$HOME/.config"}/majix
mkdir -p "$state"
[ ! -f "$state/developer-desktop" ] || exit 0
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage /usr/share/majix/wallpaper.jpg || true
fi
touch "$state/developer-desktop"
exec majix-studio

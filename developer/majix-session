#!/bin/sh
set -eu
state=${XDG_CONFIG_HOME:-"$HOME/.config"}/majix
mkdir -p "$state"
[ ! -f "$state/developer-desktop" ] || exit 0
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage /usr/share/majix/wallpaper.jpg || true
fi
touch "$state/developer-desktop"
exec majix-studio

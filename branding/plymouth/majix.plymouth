[Plymouth Theme]
Name=MAJIX OS
Description=Logotipo y animación de arranque de MAJIX OS
ModuleName=two-step

[two-step]
Font=Sans 12
TitleFont=Sans 24
ImageDir=/usr/share/plymouth/themes/majix
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.70
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.30
HorizontalAlignment=.5
VerticalAlignment=.42
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
BackgroundStartColor=0x111b31
BackgroundEndColor=0x070c17
Transition=none
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
